# ─────────────────────────────────────────────────────────────
# Adult Manga Verse — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma 7 + pg driver adapter)
# Local example:  postgresql://USER:PASSWORD@localhost:5432/mangablue?schema=public
DATABASE_URL=""

# Public base URL of the site (used for metadata, canonicals, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js v5 (added in Phase 1). Generate with: npx auth secret
AUTH_SECRET=""

# Signs the short-lived /api/img URLs chapter page scans are served through
# (covers stay public; page images do not). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IMAGE_SIGN_SECRET=""

# Admin account created/updated by `prisma/seed.ts` (pnpm prisma db seed).
# Optional — defaults to admin@mangablue.local / MangaBlue!Admin1 if unset.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── File storage — local disk by default; Cloudflare R2 recommended for ──
# ── anything beyond local dev (10GB free, zero egress fees). Leave the  ──
# ── STORAGE_DRIVER line commented/absent to use local disk.             ──
# STORAGE_DRIVER="r2"             # local | r2
#
# From the Cloudflare dashboard: R2 Object Storage → your bucket → the
# Account ID is shown in the S3 API URL. Access/secret keys come from
# R2 Object Storage → Manage R2 API Tokens → Create API Token
# (Permissions: Object Read & Write). Public URL comes from the bucket's
# Settings → Public Development URL (or a bound custom domain).
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_URL=""

# ── Crypto payments (NOWPayments) ──────────────────────────────────────
# Dashboard → API keys, and Settings → IPN settings for the secret.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# Email delivery: gmail or resend. Credentials are server-only.
EMAIL_PROVIDER="resend"
# For Gmail, set EMAIL_PROVIDER=gmail and both values below.
# Enable Google 2-Step Verification, then create a dedicated App Password.
# Gmail always sends from GMAIL_USER; EMAIL_FROM is only used for Resend.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── Transactional email (Resend) — signup/password-reset OTP codes ─────
# Dashboard → API Keys → Create API Key (Sending access is enough).
# Without a verified domain, delivery is limited to the address you signed
# up to Resend with — fine for dev, verify a domain before going live.
RESEND_API_KEY=""
EMAIL_FROM="Adult Manga Verse <onboarding@resend.dev>"
